%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 588cc702185f3fd6d80d41250f98c3d6, type: 3}
  m_Name: Lines
  m_EditorClassIdentifier: Assembly-CSharp::CoalRun.Core.Lines
  speech:
    freezing: God, it's freezing in here. Should I turn the fire up?
    shiftOver: The next guy can clean up this mess. I'm off to the staff elevator.
    fireOut: The fire went out. I need to relight it.
    nothingToLight: This isn't going to burn without coal. I need to fill the hopper
      first.
    fell: Ow! That hurt.
    wheelOff: There goes a wheel...
    cartLanding: I'm not touching that thing until it's still.
    cartBuried: Ah jeez, the cart's buried. I need to dig it out.
    tooMuchCoal: I can't pull out the cart. There's too much coal.
    handsFull: I can't carry anything else. Maybe I should put this down?
    cartNotLevel: I'm not touching that thing until it's level.
    hookFirst: I should hook the cart onto the winch first.
    cartToCradle: I need to move the cart under the cradle first.
    bothWheels: If only they let us put three wheels on this thing.
    notNow: Wow, this cart's made of pure steel. Amazing.
    offCradleFirst: I gotta get the cart off the cradle first.
    standCartFirst: I can't put on the wheel until the cart's stood up.
    cartMoving: Might be a bad idea to stick my hand in there while the cart's moving.
    tooFar: I can't reach that.
    crankFar: I can't reach the crank from here.
    shovelFar: I can't reach the shovel from here.
    clearShaft: Maybe I shouldn't stand here.
    underLift: I should consider clearing the {0} under the lift.
    standOnLift: I should probably not stand this close to the edge.
    hangingOff: The {0} is jamming the lift.
  phone:
    cold: '"Would you kindly turn up the furnace? We''re all rather uncomfortable
      right now."'
    freezing: '"Please... please handle this... please keep us alive, even just a
      little longer."'
    deaths:
    - "\"We heard there was an... incident. We\u2019re sending another guy down.\""
    - "\"Again? Fine. We\u2019re sending another guy down.\""
    - "\"We\u2019re sending another guy down. Please keep this one alive.\""
    - '"Is there something going on down there? It can''t be that dangerous, right?"'
    - '"How do you guys keep dying? What are you doing down there?"'
    - '"This is starting to get worrying."'
    - '"Mina suggested that there must be some foreman-eating machine down there
      that you''re feeding our guys into. Are you doing that?"'
    - '"At some point, we really just ought to stop sending guys down there."'
    - '"We let the next guy know that he should write his will before he went down
      there."'
    - '"Oh, looks like we prepared right."'
    - '"We''ve decided together that since you''re keeping us alive, we''ll keep
      sending you guys to work on the boiler."'
    - '"We feel like monsters for sending these people to die down there, but as
      long as you keep the rest of us alive... just keep doing what you''re doing."'
    - '"Let''s cut a deal. We say nothing from now on, you keep us alive. Cool? Cool."'
    - '"..."'
  training:
    helperIntro: '"Alright, newbie. Go up to the control chamber and pull the lever.
      I can handle the rest after that."'
    helperReassure: "\u201CMove? It\u2019ll be fine. I\u2019ve done this hundreds
      of times and it's faster this way. Just hurry up so we can report back to those
      pencil-pushers upstairs.\""
    helperGrease: '"Oh yeah, sometimes the lever gets a little finnickly first thing
      in the morning. Should be fine later. Just give it a nice and hard tug to get
      it free."'
    helperOw: "\"Ow! Maybe I should\u2019ve brought the hard hat today.\""
    helpDead: "\"...Well, the help is all dead... that\u2019s awesome.\""
    installerArrives: "\"Engineering sent me down to fix your cart. Here\u2019s your
      promised second axle. Give it a try.\""
    installerHit: '"Huh. So it goes."'
    installerLeaves: '"Ain''t she a beaut? Well, wish you luck down here. Oh, and
      if some guy comes down here looking for an axle, ignore him."'
    goPullLever: Enter the control room (W at the stairs) and pull the chute lever.
    pullLever: Pull the chute lever using the mouse.
    pullAgain: Try pulling the chute lever harder.
    stayUp: Watch chaos unfold from the safety of the control room.
    goDownDig: Leave the control room.
    grabShovel: Grab the shovel by the furnace (E).
    dig: Dig the cart out (hold F).
    keepDigging: Keep digging until the cart is free.
    haulUp: Drag the cart onto the freight lift (hold Space and walk), then turn
      the crank to go up.
    hook: Drag the cart under the tip cradle and hook it on (E).
    tip: Pull the tip lever and pour coal into the hopper.
  tasks:
    fireOut: Relight the fire (hold E at the firebox).
    fireOutEmpty: Refill the coal hopper, then relight the fire.
    standCart: Stand the cart back up (E).
    fixWheel: Put the wheel back on (pick it up with E, then hold E at the cart).
    digOut: Dig the cart out.
    fill: Fill the cart at the chute.
    haul: Take the cart up on the freight lift.
    hook: Hook the cart on at the tip cradle.
    tip: Tip the cart into the hopper.
    lower: Lower the cart.
    returnCart: Take the empty cart back down.
    burnUp: "Turn the burn lever up: it's heading for {0:0}\xB0 outside, colder than
      the heat line ({1:0}\xB0)"
    leave: The shift is over. Wait in the staff lift to return home for the day.
  prompts:
    upStairs: Ascend stairs
    downStairs: Descend stairs
    grip: Grip cart
    haul: Drag cart
    heave: Heave cart up
    letGo: Drop object
    rightCart: Right cart
    hookCart: Hook cart
    lowerCart: Lower cart
    shovel: Shovel
    pickShovel: Pick up shovel
    lightFire: Light fire
    pickWheel: Pick up wheel
    fitWheel: Fit wheel
    putWheel: Put wheel down
    throwWheel: Throw wheel
    pickBody: Pick up body
    putBody: Put body down
    throwBody: Throw body
    crank: Crank
  levers:
    chute:
      name: Chute lever
      tooFar: I can't reach the chute lever from here.
      wrongFloor: That lever's up in the control room.
    tip:
      name: Tip lever
      tooFar: I can't reach the tip lever from here.
      wrongFloor: I need to get to the second floor first.
    burn:
      name: Burn lever
      tooFar: I can't reach the burn lever from here.
      wrongFloor: I need to get to the second floor first.
  sheets:
    day: DAY {0:00}
    briefing: BRIEFING
    report: REPORT
    clockOver: OVER
    briefingHeadline: Keep the building warm until the blizzard passes.
    briefingBody: 'Haul coal from the chute to the furnace. Feed it, light it, and
      set the burn rate. The colder it gets outside, the harder it has to burn.


      We
      the people appreciate your voluntary toil for the betterment of us all. You
      are truly an inspiration.'
    targetLabel: Electrical output target
    oneWheel: The cart has 1 wheel.
    wheels: The cart has {0} wheels.
    begin: 'Begin the shift   [Enter]'
    survived: 'You have maintained our way of life.


      You successfully kept
      the offices warm.'
    lost: 'You let everyone freeze.


      Return, refit, and redeploy to purge
      the stain of this failure with the peroxide of victory.'
    pleased: We are pleased with your electrical output today.
    notPleased: We are displeased with your performance today.
    memoWaiting: A memo is waiting for you in the morning.
    lastShift: That is all the shifts there are, for now.
    frozeOver: The offices froze first. There is nobody left to send a replacement.
    outputLabel: Electrical output
    deliveredLabel: Coal delivered
    lostLabel: Operators lost
    again: 'Run the shift again   [R]'
    nextDay: 'Next day   [R]'
    fromDay1: 'Play again from Day 1   [R]'
